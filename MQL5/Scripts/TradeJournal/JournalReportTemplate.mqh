m:20px}.metric{background:white;border:1px solid var(--line);border-radius:10px;padding:15px 18px}.metric span{display:block;color:var(--muted);font-size:12px}.metric strong{font-size:22px;font-weight:600;display:block;overflow-wrap:anywhere}.metric small{color:var(--muted)}.chart-card{background:white;border:1px solid var(--line);border-radius:12px;overflow:hidden}.chart-tools{display:flex;align-items:center;gap:10px;flex-wrap:wrap;padding:13px 16px;border-bottom:1px solid var(--line)}.chart-tools .spacer{flex:1}.chart-wrap{position:relative;padding:0 8px;touch-action:pan-y}canvas{display:block;width:100%;height:425px;touch-action:none;cursor:crosshair}.tooltip{padding:7px 16px;min-height:39px;color:var(--muted);font-variant-numeric:tabular-nums;border-top:1px solid var(--line);font-size:12px}.legend{display:flex;gap:17px;flex-wrap:wrap;padding:10px 16px;color:var(--muted);font-size:12px}.legend i{display:inline-block;width:13px;height:3px;vertical-align:middle;margin-right:5px}.notice{font-size:12px;color:#76532d;background:#fff7e8;border:1px solid #ecdab7;border-radius:7px;padding:10px 13px;margin:12px 0}.fine{font-size:12px;color:var(--muted)}h3{margin:24px 0 10px;font-size:16px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:9px;background:white}table{border-collapse:collapse;min-width:750px;width:100%;font-variant-numeric:tabular-nums}th{text-align:left;background:#eaf0eb;font-size:11px;color:var(--muted);font-weight:600;white-space:nowrap}td,th{padding:10px 13px;border-bottom:1px solid #edf0eb;white-space:nowrap}td{font-size:12px}tbody tr:last-child td{border-bottom:0}details{margin:16px 0}summary{cursor:pointer;color:var(--muted)}.empty{padding:55px 20px;text-align:center;color:var(--muted)}#error{display:none;background:#ffe4dd;padding:20px}.demo{background:#e5b467;color:#293734;text-align:center;padding:6px;font-weight:600}#empty{display:none}.footer{padding:25px 0;color:var(--muted);font-size:11px}a{color:var(--green)}@media(max-width:900px){.shell{grid-template-columns:1fr}aside{border-right:0;border-bottom:1px solid var(--line);padding:15px}.list{max-height:220px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}main{padding:20px 15px}.metrics{grid-template-columns:repeat(2,1fr)}header{padding:18px}canvas{height:340px}}@media print{header{background:white;color:black}.shell{display:block}aside,.chart-tools button,#save{display:none}main{padding:0}.chart-card,table,.metric{break-inside:avoid}canvas{height:380px}details{display:block}}\n"
