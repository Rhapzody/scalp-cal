"[hidden]{display:none!important}textarea{font:inherit;resize:vertical;min-height:125px;width:100%;border:1px solid var(--line);border-radius:7px;padding:12px;color:var(--ink);background:white}textarea:focus-visible{outline:3px solid #dea45c;outline-offset:2px}.notebook-tools{display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin:0 0 16px}.notebook-tools label.action{background:white;border:1px solid var(--line);border-radius:7px;padding:7px 12px;cursor:pointer}.editor{background:#fff;border:1px solid var(--line);border-radius:12px;padding:20px;margin:20px 0}.editor h3{margin:0 0 10px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}.form-grid label{display:grid;gap:5px;font-weight:600}.form-grid label small{font-weight:400;color:var(--muted)}.form-grid input,.form-grid select{width:100%}.form-grid .wide{grid-column:1/-1}.check-row{display:flex;gap:8px;margin:8px 0;align-items:center}.check-row input[type=text]{flex:1;min-width:0}.check-row input[type=checkbox]{width:18px;height:18px}.editor details summary{font-weight:600}#overview h2{margin-bottom:8px}#journalRows td:nth-child(4),#journalRows td:nth-child(5){white-space:normal;min-width:120px;max-width:220px;overflow-wrap:anywhere}#listSearch{flex:1;min-width:200px}.list-intro{max-width:750px;color:var(--muted)}.form-grid h4{margin:10px 0 0}#showList{width:100%;margin:8px 0}.notebook-tools button.primary{background:var(--green);color:white;border-color:var(--green)}@media(max-width:650px){.form-grid{grid-template-columns:1fr}.title-row{align-items:flex-start;flex-wrap:wrap}.editor{padding:15px}}@media print{.notebook-tools,#backList,#addCheck,.check-row button{display:none}}\n"
