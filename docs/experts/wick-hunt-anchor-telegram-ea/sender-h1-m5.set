; Separate Telegram chat channel: h1_m5 | enter private ChatID/BotToken on Sender
; WickHuntAnchorTelegramSender 1.06. Enter BotToken and ChatID privately in MT5.
InpBotToken=
InpChatID=
InpQueueChannel=h1_m5
InpTimeoutMs=15000
InpSendIntervalSeconds=2
InpRetryBaseSeconds=5
InpRetryMaxSeconds=300
InpLateAfterSeconds=60
InpShowStatus=true
InpPhotoWaitSeconds=45
InpDeleteSentPictures=true
